# ClawHealth Environment Configuration
# Copy to .env and fill in values

# Patient Configuration
PATIENT_ID=
PATIENT_PHONE=+1XXXXXXXXXX
PATIENT_TIMEZONE=America/New_York

# Physician Configuration
PHYSICIAN_ID=
PHYSICIAN_NAME=

# Anthropic (Claude API - HIPAA BAA required)
ANTHROPIC_API_KEY=
CLAUDE_MODEL_PRIMARY=claude-sonnet-4-20250514
CLAUDE_MODEL_COMPLEX=claude-opus-4-5-20251101
CLAUDE_MODEL_SAFETY=claude-haiku-3-5-20241022

# Twilio (SMS + Voice)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX
TWILIO_VERIFY_SERVICE_SID=

# ElevenLabs (Voice TTS)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Deepgram (Voice STT)
DEEPGRAM_API_KEY=

# Database Encryption
ENCRYPTION_KEY=

# Gateway
GATEWAY_PORT=18789
GATEWAY_AUTH_TOKEN=

# Redis (for BullMQ job queue)
REDIS_URL=redis://localhost:6379

# Doctor Portal
PORTAL_PORT=5000
PORTAL_SECRET_KEY=

# Logging
LOG_LEVEL=info
NODE_ENV=development
