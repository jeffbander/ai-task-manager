# ClawHealth — Shared Server Configuration
# Copy to .env and fill in your API keys.
# Patient-specific settings are generated by: ./scripts/clawctl.sh add-patient

# Anthropic (Claude API)
# Get your key at https://console.anthropic.com
# For production with PHI: request HIPAA BAA from Anthropic
ANTHROPIC_API_KEY=

# Claude model configuration
CLAUDE_MODEL_PRIMARY=claude-sonnet-4-20250514
CLAUDE_MODEL_COMPLEX=claude-opus-4-5-20251101
CLAUDE_MODEL_SAFETY=claude-haiku-3-5-20241022

# Twilio (SMS + Voice)
# Get credentials at https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

# Redis (shared job queue)
REDIS_PASSWORD=clawhealth_redis_dev

# Doctor Portal
PORTAL_SECRET_KEY=change_me_in_production

# Logging
LOG_LEVEL=info
